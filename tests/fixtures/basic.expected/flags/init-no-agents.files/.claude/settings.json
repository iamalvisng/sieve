{
  "statusLine": {
    "type": "command",
    "command": "sieve statusline"
  },
  "subagentStatusLine": {
    "type": "command",
    "command": "sieve statusline"
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "sieve hook post-edit",
            "timeout": 10000
          }
        ]
      },
      {
        "matcher": "Bash|mcp__sieve__|Read|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "sieve hook tool-savings",
            "timeout": 8000
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "sieve hook post-read",
            "timeout": 5000
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sieve hook post-read",
            "timeout": 5000
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sieve hook post-search",
            "timeout": 3000
          }
        ]
      },
      {
        "matcher": "Grep",
        "hooks": [
          {
            "type": "command",
            "command": "sieve hook post-search",
            "timeout": 3000
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sieve hook prompt",
            "timeout": 15000
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sieve hook session-start",
            "timeout": 8000
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sieve hook stop",
            "timeout": 8000
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "sieve hook pre-read",
            "timeout": 5000
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sieve hook pre-read",
            "timeout": 5000
          }
        ]
      }
    ]
  },
  "footerLinksRegexes": [
    "sieve/[\\w./-]+\\.md"
  ],
  "permissions": {
    "allow": [
      "Bash(sieve:*)",
      "Bash(npx sieve:*)",
      "Bash(sieve-dev:*)",
      "Bash(node dist/cli.js:*)"
    ]
  }
}
